# Copiá este archivo a .streamlit/secrets.toml (local) o pegá el mismo
# contenido en Streamlit Cloud > Settings > Secrets. Nunca subas el archivo
# secrets.toml real a GitHub (ya está en .gitignore).

[sheets]
# IDs de las planillas de historial (la parte de la URL entre /d/ y /edit).
# Ya vienen cargados los dos archivos de gimnasio de Santa Perpètua que existen hoy.
historial_ids = [
    "1R5zs3OYz8PnSxsEYVVLeALtRyRzUTo2haRVw6X8o2kM",  # PLANIFICACION FUERZA (historial 25-26)
    "1MKPmeyWxBM0htIdqBYvPeMKzSxT0gS_P8AE5ca3OjF8",  # PLANIFICACION DE FUERZA 26-27 (temporada actual)
]
# ID de un Google Sheet vacío, propio de la app, donde se van a guardar las
# sesiones que Juan confirma. Creálo vos (ver README) y pegá su ID acá.
registro_id = "PEGAR_AQUI_EL_ID_DEL_SHEET_DE_REGISTRO"

# Credenciales de la cuenta de servicio de Google (ver README paso a paso).
# Se pega tal cual el contenido del archivo JSON descargado desde Google Cloud.
[gcp_service_account]
type = "service_account"
project_id = "TU_PROJECT_ID"
private_key_id = "TU_PRIVATE_KEY_ID"
private_key = "-----BEGIN PRIVATE KEY-----\nTU_CLAVE_PRIVADA\n-----END PRIVATE KEY-----\n"
client_email = "tu-cuenta@tu-proyecto.iam.gserviceaccount.com"
client_id = "TU_CLIENT_ID"
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url = "TU_CERT_URL"
